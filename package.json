{
  "name": "imperfect",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node system/start.mjs",
    "start:website": "node tools/serve.mjs",
    "check": "node tools/art-check.mjs",
    "pretest": "node tools/test-browser.mjs",
    "pretest:code": "node tools/test-browser.mjs",
    "test": "node tools/test-run.mjs",
    "test:changed": "node tools/test-run.mjs --changed",
    "test:code": "node --test apps/code/native/test/*.test.mjs apps/code/test/*.test.mjs",
    "test:all": "npm test && npm run check",
    "shot": "node tools/shot.mjs",
    "start:locker": "node locker/start.mjs",
    "test:locker": "node --test locker/test/*.test.mjs",
    "postinstall": "node tools/postinstall.mjs",
    "desktop:client": "electron desktop/client",
    "desktop:linux": "node desktop/client/build/package.mjs linux",
    "desktop:win": "node desktop/client/build/package.mjs win",
    "desktop:mac": "node desktop/client/build/package.mjs mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "sherpa-onnx-node": "1.13.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "vite": "8.3.4"
  },
  "description": "One computer, many forms, never finished."
}
