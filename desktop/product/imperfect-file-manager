#!/usr/bin/env python3
"""Handle desktop Show in Folder requests in imperfect, without Nautilus."""
import os
import subprocess
from urllib.parse import unquote, urlparse
from gi.repository import Gio, GLib

XML = """<node><interface name="org.freedesktop.FileManager1">
<method name="ShowFolders"><arg type="as" direction="in"/><arg type="s" direction="in"/></method>
<method name="ShowItems"><arg type="as" direction="in"/><arg type="s" direction="in"/></method>
<method name="ShowItemProperties"><arg type="as" direction="in"/><arg type="s" direction="in"/></method>
</interface></node>"""

def main():
    loop = GLib.MainLoop()
    def call(connection, sender, object_path, interface, method, parameters, invocation):
        try:
            for uri in parameters.unpack()[0]:
                parsed = urlparse(uri)
                if parsed.scheme != 'file' or parsed.netloc not in ('', 'localhost'):
                    raise ValueError('Only local file locations are supported')
                path = unquote(parsed.path)
                if method != 'ShowFolders':
                    path = os.path.dirname(path)
                subprocess.Popen([os.path.expanduser('~/.local/bin/imperfect-open'), 'files', path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            invocation.return_value(None)
        except Exception as error:
            invocation.return_dbus_error('org.freedesktop.FileManager1.Error', str(error))
    def acquired(connection, name):
        connection.register_object('/org/freedesktop/FileManager1', Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0], call, None, None)
    owner = Gio.bus_own_name(Gio.BusType.SESSION, 'org.freedesktop.FileManager1', Gio.BusNameOwnerFlags.NONE, acquired, None, lambda *args: loop.quit())
    try:
        loop.run()
    finally:
        Gio.bus_unown_name(owner)

if __name__ == '__main__':
    main()
